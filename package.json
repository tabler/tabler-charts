{
  "name": "tabler-charts-monorepo",
  "private": true,
  "type": "module",
  "description": "Zero-dependency SVG charts styled with CSS — core, React, Vue, Bootstrap and Web Component.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm lint:pkg && pnpm size",
    "lint:pkg": "pnpm -r --if-present lint:pkg",
    "docs:dev": "pnpm --filter @tabler/charts-docs dev",
    "docs:build": "pnpm --filter @tabler/charts-docs build",
    "size": "node scripts/bundles.mjs && node scripts/check-size.mjs",
    "generate:maps": "node scripts/generate-maps.ts",
    "examples:build": "pnpm -r --filter \"./examples/**\" build",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.33.0",
    "publint": "^0.3.25",
    "rolldown": "^1.3.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
