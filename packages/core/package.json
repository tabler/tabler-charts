{
  "name": "@tabler/charts",
  "version": "0.0.0",
  "description": "Zero-dependency SVG charts styled with CSS.",
  "keywords": [
    "charts",
    "svg",
    "css",
    "dataviz",
    "graph",
    "zero-dependency",
    "ssr"
  ],
  "license": "MIT",
  "author": "Paweł Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecalm/tabler-charts.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./line": {
      "import": {
        "types": "./dist/line.d.ts",
        "default": "./dist/line.js"
      },
      "require": {
        "types": "./dist/line.d.cts",
        "default": "./dist/line.cjs"
      }
    },
    "./area": {
      "import": {
        "types": "./dist/area.d.ts",
        "default": "./dist/area.js"
      },
      "require": {
        "types": "./dist/area.d.cts",
        "default": "./dist/area.cjs"
      }
    },
    "./bar": {
      "import": {
        "types": "./dist/bar.d.ts",
        "default": "./dist/bar.js"
      },
      "require": {
        "types": "./dist/bar.d.cts",
        "default": "./dist/bar.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16 --exclude-entrypoints ./style.css"
  },
  "publishConfig": {
    "access": "public"
  }
}
