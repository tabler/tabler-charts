{
  "name": "@tabler/charts",
  "version": "0.4.0",
  "description": "Zero-dependency SVG charts styled with CSS.",
  "keywords": [
    "charts",
    "svg",
    "css",
    "dataviz",
    "graph",
    "zero-dependency",
    "ssr"
  ],
  "license": "MIT",
  "author": "Paweł Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-charts.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/time.js",
    "./dist/time.cjs",
    "./dist/log.js",
    "./dist/log.cjs",
    "./dist/decimate.js",
    "./dist/decimate.cjs",
    "./dist/line.js",
    "./dist/line.cjs",
    "./src/index.ts",
    "./src/line.ts",
    "./src/time.ts",
    "./src/log.ts",
    "./src/decimate.ts",
    "./dist/annotations.js",
    "./dist/annotations.cjs",
    "./src/annotations.ts",
    "./dist/patterns.js",
    "./dist/patterns.cjs",
    "./src/patterns.ts",
    "./dist/end-labels.js",
    "./dist/end-labels.cjs",
    "./src/end-labels.ts",
    "./dist/slice-labels.js",
    "./dist/slice-labels.cjs",
