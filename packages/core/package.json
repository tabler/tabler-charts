    },
    "./heatmap": {
      "import": "./dist/heatmap.js",
      "require": "./dist/heatmap.cjs"
    },
    "./hydrate": {
      "import": "./dist/hydrate.js",
      "require": "./dist/hydrate.cjs"
    },
    "./line": {
      "import": "./dist/line.js",
      "require": "./dist/line.cjs"
    },
    "./log": {
      "import": "./dist/log.js",
      "require": "./dist/log.cjs"
    },
    "./map": {
      "import": "./dist/map.js",
      "require": "./dist/map.cjs"
    },
    "./maps/world": {
      "import": "./dist/maps/world.js",
      "require": "./dist/maps/world.cjs"
    },
    "./morph": {
      "import": "./dist/morph.js",
      "require": "./dist/morph.cjs"
    },
    "./parliament": {
      "import": "./dist/parliament.js",
      "require": "./dist/parliament.cjs"
    },
    "./patterns": {
      "import": "./dist/patterns.js",
      "require": "./dist/patterns.cjs"
    },
    "./percentage-bar": {
      "import": "./dist/percentage-bar.js",
      "require": "./dist/percentage-bar.cjs"
    },
    "./pie": {
      "import": "./dist/pie.js",
      "require": "./dist/pie.cjs"
    },
    "./point-shapes": {
      "import": "./dist/point-shapes.js",
      "require": "./dist/point-shapes.cjs"
    },
    "./radar": {
      "import": "./dist/radar.js",
      "require": "./dist/radar.cjs"
    },
    "./sankey": {
      "import": "./dist/sankey.js",
      "require": "./dist/sankey.cjs"
    },
    "./scatter": {
      "import": "./dist/scatter.js",
      "require": "./dist/scatter.cjs"
    },
    "./slice-labels": {
      "import": "./dist/slice-labels.js",
      "require": "./dist/slice-labels.cjs"
    },
    "./sparkline": {
      "import": "./dist/sparkline.js",
      "require": "./dist/sparkline.cjs"
    },
    "./time": {
      "import": "./dist/time.js",
      "require": "./dist/time.cjs"
    },
    "./treemap": {
      "import": "./dist/treemap.js",
      "require": "./dist/treemap.cjs"
    },
    "./value-labels": {
      "import": "./dist/value-labels.js",
      "require": "./dist/value-labels.cjs"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16 --exclude-entrypoints ./style.css"
  },
  "publishConfig": {
    "access": "public"
  }
}
