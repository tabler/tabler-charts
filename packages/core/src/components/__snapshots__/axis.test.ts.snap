// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`axis() > renders a bottom axis 1`] = `"<g class="tc-axis tc-axis-x tc-axis-bottom" aria-hidden="true"><line class="tc-axis-line" x1="40" x2="340" y1="210" y2="210"/><g class="tc-tick" transform="translate(90,210)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Jan</text></g><g class="tc-tick" transform="translate(190,210)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Feb</text></g><g class="tc-tick" transform="translate(290,210)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Mar</text></g></g>"`;

exports[`axis() > renders a left axis with tick marks 1`] = `"<g class="tc-axis tc-axis-y tc-axis-left" aria-hidden="true"><g class="tc-tick" transform="translate(40,210)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">0</text></g><g class="tc-tick" transform="translate(40,110)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">50</text></g><g class="tc-tick" transform="translate(40,10)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">100</text></g></g>"`;

exports[`grid() > renders horizontal lines and marks the zero line 1`] = `"<g class="tc-grid tc-grid-y" aria-hidden="true"><line class="tc-grid-line" x1="40" x2="340" y1="210" y2="210"/><line class="tc-grid-line tc-grid-line-zero" x1="40" x2="340" y1="110" y2="110"/><line class="tc-grid-line" x1="40" x2="340" y1="10" y2="10"/></g>"`;
