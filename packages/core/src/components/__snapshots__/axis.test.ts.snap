// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`axis() > renders a bottom axis 1`] = `"<g class="tc-axis tc-axis-x tc-axis-bottom" aria-hidden="true"><line class="tc-axis-line" x1="40" x2="340" y1="210" y2="210"/><g class="tc-tick" style="transform:translate(90px,210px)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Jan</text></g><g class="tc-tick" style="transform:translate(190px,210px)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Feb</text></g><g class="tc-tick" style="transform:translate(290px,210px)"><text class="tc-tick-label" y="8" dy="0.71em" text-anchor="middle">Mar</text></g></g>"`;

exports[`axis() > renders a left axis with tick marks 1`] = `"<g class="tc-axis tc-axis-y tc-axis-left" aria-hidden="true"><g class="tc-tick" style="transform:translate(40px,210px)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">0</text></g><g class="tc-tick" style="transform:translate(40px,110px)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">50</text></g><g class="tc-tick" style="transform:translate(40px,10px)"><line class="tc-tick-line" x2="-4"/><text class="tc-tick-label" x="-12" dy="0.32em" text-anchor="end">100</text></g></g>"`;

exports[`grid() > renders horizontal lines and marks the zero line 1`] = `"<g class="tc-grid tc-grid-y" aria-hidden="true"><line class="tc-grid-line" x1="40" x2="340" y1="0" y2="0" style="transform:translateY(210px)"/><line class="tc-grid-line tc-grid-line-zero" x1="40" x2="340" y1="0" y2="0" style="transform:translateY(110px)"/><line class="tc-grid-line" x1="40" x2="340" y1="0" y2="0" style="transform:translateY(10px)"/></g>"`;
