{
  "name": "@tabler/charts-elements",
  "version": "0.0.0",
  "description": "<tabler-chart> web component for @tabler/charts.",
  "keywords": [
    "charts",
    "svg",
    "web-component",
    "custom-element",
    "tabler"
  ],
  "license": "MIT",
  "author": "Pawe\u0142 Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-charts.git",
    "directory": "packages/elements"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/tabler-charts.min.js",
  "jsdelivr": "./dist/tabler-charts.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./shadow": {
      "import": {
        "types": "./dist/shadow.d.ts",
        "default": "./dist/shadow.js"
      },
      "require": {
        "types": "./dist/shadow.d.cts",
        "default": "./dist/shadow.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@tabler/charts": "workspace:^"
  },
  "devDependencies": {
    "@tabler/charts": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
