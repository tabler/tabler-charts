{
  "name": "@tabler/charts-react",
  "version": "0.2.0",
  "description": "React components and hook for @tabler/charts, with SSR.",
  "keywords": [
    "charts",
    "svg",
    "react",
    "ssr",
    "tabler"
  ],
  "license": "MIT",
  "author": "Paweł Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-charts.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@tabler/charts": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@tabler/charts": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
