{
  "name": "@tabler/charts-bootstrap",
  "version": "0.2.0",
  "description": "Bootstrap 5.3 and Tabler theme mapping (CSS and SCSS) and a data API for @tabler/charts.",
  "keywords": [
    "charts",
    "svg",
    "bootstrap",
    "scss",
    "tabler"
  ],
  "license": "MIT",
  "author": "Paweł Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-charts.git",
    "directory": "packages/bootstrap"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/tabler-charts-bootstrap.min.js",
  "jsdelivr": "./dist/tabler-charts-bootstrap.min.js",
  "style": "./dist/bootstrap.css",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./bootstrap.css": "./dist/bootstrap.css",
    "./tabler.css": "./dist/tabler.css",
    "./scss/charts": {
      "sass": "./scss/_charts.scss",
      "default": "./scss/_charts.scss"
    },
    "./scss/tabler": {
      "sass": "./scss/_tabler.scss",
      "default": "./scss/_tabler.scss"
    }
  },
  "files": [
    "dist",
    "scss"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16 --exclude-entrypoints ./bootstrap.css ./tabler.css ./scss/charts ./scss/tabler"
  },
  "peerDependencies": {
    "@tabler/charts": "workspace:^",
    "bootstrap": ">=5.3"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tabler/charts": "workspace:^",
    "sass": "^1.108.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
