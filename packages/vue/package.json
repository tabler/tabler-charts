{
  "name": "@tabler/charts-vue",
  "version": "0.0.0",
  "description": "Vue 3 components and composable for @tabler/charts, with SSR.",
  "keywords": [
    "charts",
    "svg",
    "vue",
    "nuxt",
    "ssr",
    "tabler"
  ],
  "license": "MIT",
  "author": "Paweł Kuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-charts.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p .",
    "lint:pkg": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@tabler/charts": "workspace:^",
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@tabler/charts": "workspace:^",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public"
  }
}
